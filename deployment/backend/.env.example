# Copy to deployment/backend/.env; never commit the copy.
# One long random value used consistently by PostgreSQL, migrations and backend.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_USER=ddu_app
POSTGRES_DB=ddu_game
API_HOST_PORT=8000
WORKER_POLL_SECONDS=10
# Must exceed WORKER_POLL_SECONDS by more than 4 seconds; allow extra time for DB writes.
WORKER_STALE_SECONDS=45
