EVAL_SPLIT=pilot
EVAL_PROFILES=bm25,dense,hybrid,hybrid_rerank
EVAL_EXECUTION_LOCATION=local
EVAL_CACHE_STATE=warm
EVAL_WARMUP_COUNT=2
EVAL_EMBED_URL=http://ddu-embed:8080
EVAL_RERANK_URL=http://ddu-rerank:8080
EVAL_GENERATOR_URL=http://ddu-llm:8080
EVAL_GENERATOR_MODEL=ddu-narrator
