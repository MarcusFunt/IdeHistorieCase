# Absolute path to backend/evaluation_data/versailles-1919
EVAL_DATA_PATH=D:/path/to/IdeHistorieCase/backend/evaluation_data/versailles-1919
# Absolute path to the private, ignored results directory
EVAL_RESULTS_PATH=D:/path/to/IdeHistorieCase/backend/evaluation-results
