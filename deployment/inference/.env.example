# Copy to deployment/inference/.env; set a real host path + GGUF filename.
# No dependency on existing AI-Stack containers.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLM_MODELS_DIR=/absolute/path/to/gguf-model-directory
LLM_GGUF_FILE=your-compatible-instruct-model.gguf
LLM_CTX_SIZE=4096
LLM_GPU_LAYERS=99
LLM_PARALLEL=1
